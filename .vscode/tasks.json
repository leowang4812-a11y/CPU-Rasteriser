{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}",
                }
            },
            "command": "cmd",
            "args": [
                "/c",
                "g++ main.cpp -lgdi32 -lwinmm -o main.exe && main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "bin\\main.exe",
            "dependsOn": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "build pch",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}",
                }
            },
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-g",
                "-O0",

                "-std=c++20",

                "-Ibin",
                "-Iinclude",

                "-Iinclude/asset_managers",
                "-Iinclude/renderer",
                "-Ithird_party",

                "-IC:/msys64/ucrt64/include",

                "-x",
                "c++-header",

                "include/pch.h",

                "-o",
                "include/pch.h.gch"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}